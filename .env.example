# Public Supabase values are safe for the browser and enable realtime reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for QR join URLs. Use the Vercel/production origin later.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One active birthday party session is expected for production.
PARTY_JOIN_CODE=han-turns-one
PARTY_SESSION_IS_TEST=true

# Host access. Prefer HOST_PIN_HASH, generated with:
# node -e "console.log(require('crypto').createHash('sha256').update('123456').digest('hex'))"
HOST_PIN_HASH=
HOST_PIN=
HOST_SESSION_SECRET=
