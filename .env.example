# Public Supabase values are safe for the browser and enable realtime reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used for QR join URLs. Use the Vercel/production origin later.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Current session selection is scoped by party key and deployment environment.
PARTY_KEY=han-first-birthday
PARTY_DEPLOYMENT_ENVIRONMENT=development
PARTY_JOIN_CODE=han-turns-one

# Metadata only: marks rehearsal/test rows for reporting and cleanup.
PARTY_SESSION_IS_TEST=true

# Host access. Prefer HOST_PIN_HASH, generated with:
# HOST_PIN='choose-a-private-pin' node -e "console.log(require('crypto').createHash('sha256').update(process.env.HOST_PIN).digest('hex'))"
HOST_PIN_HASH=
HOST_PIN=
HOST_SESSION_SECRET=

# Optional approved display date for the winner certificate, for example "26 July 2026".
# When omitted, the localized event title is shown instead; do not invent a date.
CERTIFICATE_EVENT_DATE=
